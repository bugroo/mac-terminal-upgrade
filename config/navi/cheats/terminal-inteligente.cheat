% sistema, diagnostico

# Ver carga y tiempo activo del Mac
uptime

# Ver espacio libre del disco principal
df -h /

# Ver los elementos que más espacio ocupan en la carpeta actual
du -sh -- * 2>/dev/null | sort -h | tail -20

# Ver procesos por uso de CPU
ps -Ao pid,pcpu,pmem,comm -r | head -16

% archivos, buscar

# Buscar texto dentro de una carpeta
rg --hidden --glob '!.git' <texto> <carpeta>

$ carpeta: printf '.\n'

# Buscar archivos por nombre
find <carpeta> -iname '*<nombre>*' -print

$ carpeta: printf '.\n'

% git, lectura

# Ver estado resumido del repositorio
git status --short --branch

# Ver los últimos cambios sin modificar nada
git log --oneline --decorate -20

# Revisar diferencias sin modificar nada
git diff --check && git diff --stat

% pnpm, proyecto

# Ejecutar una verificación conocida del proyecto con pnpm
pnpm run <verificacion>

$ verificacion: printf 'test\nlint\ntypecheck\nbuild\n'

% sesiones, tmux

# Abrir o recuperar el espacio de trabajo principal
tmux new-session -A -s main

# Ver sesiones disponibles
tmux list-sessions

% ia, asistencia

# Abrir Codex en modo lectura
ai

# Abrir Codex con permiso para modificar el proyecto actual
ai-build

# Abrir Codex con búsqueda web y sin modificar archivos
ai-web
