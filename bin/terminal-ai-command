#!/bin/zsh

set -u

if (( $# != 1 )) || [[ -z "${1//[[:space:]]/}" ]]; then
    print -u2 -- "Escribe una petición después de #."
    exit 2
fi

if (( ${#1} > 1000 )); then
    print -u2 -- "La petición supera los 1000 caracteres."
    exit 2
fi

if ! command -v codex >/dev/null 2>&1; then
    print -u2 -- "Codex CLI no está disponible."
    exit 127
fi

if ! command -v jq >/dev/null 2>&1; then
    print -u2 -- "jq no está disponible."
    exit 127
fi

terminal_ai_tmp="$(mktemp -d "${TMPDIR:-/tmp}/terminal-ai.XXXXXX")" || exit 1
trap 'rm -rf -- "$terminal_ai_tmp"' EXIT INT TERM HUP

terminal_ai_schema="${TERMINAL_AI_SCHEMA:-$HOME/.config/mac-terminal-upgrade/terminal-ai/command.schema.json}"
terminal_ai_output="$terminal_ai_tmp/answer.json"
terminal_ai_prompt="You translate a Spanish or English natural-language request into exactly one read-only, single-line zsh command for macOS. Do not execute commands, inspect files, use tools, read history, add Markdown, use redirections, shell variables, quoting, escapes, or propose writes. Prefer these commands: eza, ls, find, rg, grep, du, df, stat, file, head, tail, sort, wc, cut, tr, ps, lsof, pwd, date, uptime, sw_vers, uname, vm_stat, memory_pressure, which, type, limited Git status/metadata queries, brew read-only subcommands. If the request cannot be satisfied read-only, return a command value beginning with # REFUSED: followed by a short Spanish reason. Request: $1"

if ! codex exec \
    --ephemeral \
    --ignore-rules \
    --disable plugins \
    --disable apps \
    --disable memories \
    --disable tool_suggest \
    --disable hooks \
    --skip-git-repo-check \
    --sandbox read-only \
    -c 'model_reasoning_effort="low"' \
    --color never \
    --cd "$terminal_ai_tmp" \
    --output-schema "$terminal_ai_schema" \
    --output-last-message "$terminal_ai_output" \
    "$terminal_ai_prompt" \
    </dev/null \
    >/dev/null 2>"$terminal_ai_tmp/error.log"; then
    print -u2 -- "La IA no pudo generar el comando. Ejecuta 'codex login' y prueba otra vez."
    exit 1
fi

terminal_ai_command="$(jq -er '.command | select(type == "string" and length > 0)' "$terminal_ai_output")" || {
    print -u2 -- "La IA devolvió una respuesta inválida."
    exit 1
}

refuse_generated_command() {
    print -r -- "# REFUSED: la propuesta no pasó la política local de solo lectura"
    exit 0
}

[[ "$terminal_ai_command" == *[[:cntrl:]]* ]] && refuse_generated_command

case "$terminal_ai_command" in
    *';'*|*'&'*|*'>'*|*'<'*|*'`'*|*'$'*|*'!'*|*'('*|*')'*|*'{'*|*'}'*|*'"'*|*"'"*|*'\\'*|*'*'*|*'?'*|*'['*|*']'*)
        refuse_generated_command
        ;;
esac

[[ "$terminal_ai_command" == '# REFUSED:'* ]] && {
    print -r -- "$terminal_ai_command"
    exit 0
}

terminal_ai_segments=("${(@s:|:)terminal_ai_command}")
for terminal_ai_segment in "${terminal_ai_segments[@]}"; do
    terminal_ai_segment="${terminal_ai_segment#"${terminal_ai_segment%%[![:space:]]*}"}"
    terminal_ai_segment="${terminal_ai_segment%"${terminal_ai_segment##*[![:space:]]}"}"
    terminal_ai_program="${terminal_ai_segment%%[[:space:]]*}"
    terminal_ai_rest="${terminal_ai_segment#"$terminal_ai_program"}"
    terminal_ai_rest="${terminal_ai_rest#"${terminal_ai_rest%%[![:space:]]*}"}"
    terminal_ai_subcommand="${terminal_ai_rest%%[[:space:]]*}"

    case "$terminal_ai_program" in
        eza|ls|grep|du|df|stat|file|head|tail|wc|cut|tr|column|ps|lsof|pwd|cal|uptime|sw_vers|uname|vm_stat|which|whence|type|basename|dirname|realpath|mdfind|cd|pushd|popd|z|zi)
            ;;
        date)
            [[ "$terminal_ai_segment" == date || "$terminal_ai_segment" == 'date -u' ]] || refuse_generated_command
            ;;
        memory_pressure)
            [[ "$terminal_ai_segment" == memory_pressure || "$terminal_ai_segment" == 'memory_pressure -Q' ]] || refuse_generated_command
            ;;
        rg)
            [[ "$terminal_ai_segment" == *'--pre'* ]] && refuse_generated_command
            ;;
        sort)
            case "$terminal_ai_segment" in
                sort|'sort -r'|'sort -n'|'sort -nr'|'sort -rn'|'sort -h'|'sort -hr'|'sort -rh'|'sort -u') ;;
                *) refuse_generated_command ;;
            esac
            ;;
        find)
            case "$terminal_ai_segment" in
                *'-delete'*|*'-exec'*|*'-execdir'*|*'-ok'*|*'-okdir'*|*'-fls'*|*'-fprint'*|*'-fprintf'*) refuse_generated_command ;;
            esac
            ;;
        git)
            case "$terminal_ai_segment" in
                'git status'|'git status -s'|'git status -sb'|'git status --short'|'git status --porcelain'|'git status --porcelain=v1'|'git status --porcelain=v2'|'git rev-parse --show-toplevel'|'git rev-parse --is-inside-work-tree'|'git describe'|'git describe --tags'|'git ls-files') ;;
                *) refuse_generated_command ;;
            esac
            ;;
        brew)
            case "$terminal_ai_subcommand" in
                list|info|search|outdated|leaves|deps|uses|doctor|config) ;;
                *) refuse_generated_command ;;
            esac
            ;;
        pmset)
            [[ "$terminal_ai_subcommand" == -g* ]] || refuse_generated_command
            ;;
        diskutil)
            case "$terminal_ai_subcommand" in
                list|info) ;;
                *) refuse_generated_command ;;
            esac
            ;;
        *)
            refuse_generated_command
            ;;
    esac
done

print -r -- "$terminal_ai_command"
